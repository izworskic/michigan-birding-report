{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "destination": "https://michiganbirdingreport.com/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "birding.chrisizworski.com"
        }
      ],
      "destination": "https://michiganbirdingreport.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/saginaw-bay",
      "destination": "/saginaw-bay.html"
    },
    {
      "source": "/predictions",
      "destination": "/predictions.html"
    },
    {
      "source": "/migration",
      "destination": "/migration.html"
    },
    {
      "source": "/county/:fips",
      "destination": "/county.html"
    },
    {
      "source": "/species/:code",
      "destination": "/species.html"
    },
    {
      "source": "/chris-izworski",
      "destination": "/chris-izworski.html"
    },
    {
      "source": "/chris-izworski/",
      "destination": "/chris-izworski.html"
    },
    {
      "source": "/chris-izworski-saginaw-bay-birding",
      "destination": "/chris-izworski-saginaw-bay-birding.html"
    },
    {
      "source": "/chris-izworski-saginaw-bay-birding/",
      "destination": "/chris-izworski-saginaw-bay-birding.html"
    },
    {
      "source": "/chris-izworski-michigan-birding-field-notes",
      "destination": "/chris-izworski-michigan-birding-field-notes.html"
    },
    {
      "source": "/chris-izworski-michigan-birding-field-notes/",
      "destination": "/chris-izworski-michigan-birding-field-notes.html"
    },
    {
      "source": "/((?!api/)(?!_next/)(?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/species-profile.js": {
      "memory": 512,
      "maxDuration": 30
    },
    "api/predict.js": {
      "memory": 256,
      "maxDuration": 20
    },
    "api/recommend.js": {
      "memory": 256,
      "maxDuration": 15
    },
    "api/**/*.js": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?<sub>.*)\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=900, stale-while-revalidate=1800"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "$schema": "https://openapi.vercel.sh/vercel.json"
}
